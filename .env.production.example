POSTGRES_DB=securescan
POSTGRES_USER=securescan
# Tutti i placeholder di questo file devono essere sostituiti prima dell'uso.
# Esegui il preflight production con:
# bash scripts/validate-production-env.sh --env-file /percorso/.env.production
POSTGRES_PASSWORD=<SET_A_STRONG_POSTGRES_PASSWORD>
DATABASE_URL=postgresql+psycopg://securescan:<SET_A_STRONG_POSTGRES_PASSWORD>@postgres:5432/securescan

# URL pubblici dell'ambiente Internet-facing.
SECURESCAN_PUBLIC_SCHEME=https
SECURESCAN_PUBLIC_FRONTEND_URL=https://app.example.com
SECURESCAN_PUBLIC_API_URL=https://app.example.com/api
SECURESCAN_PUBLIC_KEYCLOAK_URL=https://auth.example.com
SECURESCAN_PUBLIC_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
KONG_CORS_ALLOWED_ORIGINS=https://app.example.com

# Frontend build-time configuration.
# Il browser parla con la stessa origin pubblica dell'app; Caddy inoltra poi
# `/api/*` verso Kong mantenendo inalterati i path backend.
VITE_ANALYSIS_API_URL=https://app.example.com
VITE_MAX_UPLOAD_SIZE_MB=250
VITE_KEYCLOAK_URL=https://auth.example.com
VITE_KEYCLOAK_REALM=securescan
VITE_KEYCLOAK_CLIENT_ID=securescan-frontend

# Keycloak public hostname and client URLs.
KEYCLOAK_PUBLIC_HOSTNAME=https://auth.example.com
KEYCLOAK_SSL_REQUIRED=external
KEYCLOAK_FRONTEND_CLIENT_ID=securescan-frontend
KEYCLOAK_FRONTEND_ROOT_URL=https://app.example.com
KEYCLOAK_FRONTEND_BASE_URL=https://app.example.com
KEYCLOAK_FRONTEND_REDIRECT_URIS=https://app.example.com/*
KEYCLOAK_FRONTEND_WEB_ORIGINS=https://app.example.com
KEYCLOAK_FRONTEND_POST_LOGOUT_REDIRECT_URIS=https://app.example.com/*
KEYCLOAK_DISABLE_DEMO_USERS=true

# Keycloak runtime and OIDC integration.
AUTH_ENABLED=true
KEYCLOAK_REALM=securescan
KEYCLOAK_ISSUER=https://auth.example.com/realms/securescan
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/securescan/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=securescan-api
KEYCLOAK_ADMIN_USERNAME=<SET_A_STRONG_KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME>
KEYCLOAK_ADMIN_PASSWORD=<SET_A_STRONG_KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD>
KEYCLOAK_ADMIN_CLIENT_ID=securescan-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=<SET_A_STRONG_BACKEND_CLIENT_SECRET>
KEYCLOAK_PASSWORD_VERIFICATION_CLIENT_ID=securescan-password-verification
KEYCLOAK_PASSWORD_VERIFICATION_CLIENT_SECRET=<SET_A_STRONG_PASSWORD_VERIFICATION_CLIENT_SECRET>
KEYCLOAK_ADMIN_REQUEST_TIMEOUT_SECONDS=5
KEYCLOAK_EMAIL_ACTIONS_CLIENT_ID=securescan-frontend
KEYCLOAK_EMAIL_ACTIONS_REDIRECT_URL=https://app.example.com/profile
EMAIL_VERIFICATION_ENABLED=true

# Keycloak production start mode.
KEYCLOAK_HTTP_ENABLED=true
KEYCLOAK_PROXY_HEADERS=xforwarded
KEYCLOAK_HOSTNAME_STRICT=true
KEYCLOAK_HOSTNAME_STRICT_HTTPS=true
KEYCLOAK_DB_VENDOR=postgres
KEYCLOAK_DB_HOST=postgres
KEYCLOAK_DB_PORT=5432
# Database e utente dedicati a Keycloak nello stesso PostgreSQL della VM.
KEYCLOAK_DB_NAME=<SET_A_KEYCLOAK_DATABASE_NAME>
KEYCLOAK_DB_USERNAME=<SET_A_KEYCLOAK_DATABASE_USERNAME>
KEYCLOAK_DB_PASSWORD=<SET_A_KEYCLOAK_DATABASE_PASSWORD>

# SMTP transazionale per verifica email e reset password.
KEYCLOAK_SMTP_HOST=smtp.gmail.com
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_FROM=<NOREPLY_ADDRESS@example.com>
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=SecureScan Cloud
KEYCLOAK_SMTP_AUTH=true
KEYCLOAK_SMTP_USER=<SMTP_USERNAME_OR_EMAIL>
KEYCLOAK_SMTP_PASSWORD=<SMTP_APP_PASSWORD>
KEYCLOAK_SMTP_SSL=false
KEYCLOAK_SMTP_STARTTLS=true

# Malware scanning e limiti applicativi invariati.
UPLOAD_DIR=/data/uploads
AVATAR_DIR=/data/avatars
MAX_UPLOAD_SIZE_MB=250
MAX_AVATAR_SIZE_MB=5
CLAMD_HOST=clamav
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=120
YARA_RULES_DIR=/srv/analysis-worker/rules
YARA_MATCH_TIMEOUT_SECONDS=30

# Monitoring interno non pubblico.
MONITORING_HTTP_TIMEOUT_SECONDS=2
KONG_STATUS_URL=http://kong:8100/status/ready
PROMETHEUS_HEALTH_URL=http://prometheus:9090/-/healthy
GRAFANA_HEALTH_URL=http://grafana:3000/api/health
POSTGRES_EXPORTER_METRICS_URL=http://postgres-exporter:9187/metrics
GRAFANA_ADMIN_USER=<SET_A_GRAFANA_ADMIN_USERNAME>
GRAFANA_ADMIN_PASSWORD=<SET_A_STRONG_GRAFANA_ADMIN_PASSWORD>

# Worker heartbeat e polling.
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TIMEOUT_SECONDS=15
WORKER_MIN_PROCESSING_SECONDS=0
WORKER_PROCESSING_TIMEOUT_SECONDS=120
WORKER_MAX_ATTEMPTS=3
WORKER_ID=
WORKER_HEALTH_PORT=8081
API_HEARTBEAT_ENABLED=true
API_HEARTBEAT_INTERVAL_SECONDS=5
API_HEARTBEAT_TIMEOUT_SECONDS=15
CONFIGURED_API_REPLICAS=2

# Kong HA, rate limiting e request size invariati rispetto alla demo locale.
KONG_RATE_LIMIT_GET_PER_MINUTE=600
KONG_RATE_LIMIT_ME_GET_PER_MINUTE=240
KONG_RATE_LIMIT_ME_WRITE_PER_MINUTE=60
KONG_RATE_LIMIT_POST_PER_MINUTE=30
KONG_RATE_LIMIT_DELETE_PER_MINUTE=10
KONG_MAX_REQUEST_SIZE_MB=256
