{
  // Configura il controllo statico dei sorgenti browser; Vite si occupa della produzione del bundle.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    // Include le API JavaScript ES2023 e i tipi DOM per document, elementi HTML ed eventi del browser.
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    // Rende disponibili i tipi Vite usati anche per import.meta.env.
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    // Risolve gli import secondo il modello del bundler che produrrà il codice eseguito dal browser.
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // Mantiene la distinzione esplicita tra import di valori e import type eliminati dal JavaScript.
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    // Non genera JavaScript durante il controllo TypeScript; react-jsx abilita la trasformazione JSX automatica.
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    // Segnala variabili e parametri inutilizzati senza eliminarli o correggerli automaticamente.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    // Segnala i passaggi impliciti fra casi switch che contengono istruzioni.
    "noFallthroughCasesInSwitch": true
  },
  // Limita questo progetto TypeScript ai sorgenti dell’applicazione nella directory src.
  "include": ["src"]
}
