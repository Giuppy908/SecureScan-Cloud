# Variabili lette in fase di build dal frontend Vite.
# In locale puntano ai servizi della demo Docker; in altri ambienti possono
# essere sovrascritte senza cambiare il codice React.
VITE_ANALYSIS_API_URL=http://localhost:8000
VITE_MAX_UPLOAD_SIZE_MB=250
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=securescan
VITE_KEYCLOAK_CLIENT_ID=securescan-frontend
