# Override minimo per la variante demo locale.
# Questo file non e` pensato per production: modifica solo pochi valori della
# configurazione base quando si avvia lo stack con l'overlay demo.
#
# L'effetto principale e` rendere piu` rapida e leggera la presentazione
# locale, senza cambiare il comportamento architetturale generale del progetto.
WORKER_MIN_PROCESSING_SECONDS=2
MAX_UPLOAD_SIZE_MB=50
