POSTGRES_DB=securescan
POSTGRES_USER=securescan
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://securescan:change-me@postgres:5432/securescan

# URL locali attuali usati dalla demo Compose.
# In una futura milestone production potranno restare valorizzate in locale
# e venire sostituite da URL pubblici senza cambiare il codice applicativo.
SECURESCAN_PUBLIC_SCHEME=http
SECURESCAN_PUBLIC_FRONTEND_URL=http://localhost:8080
SECURESCAN_PUBLIC_API_URL=http://localhost:8000
SECURESCAN_PUBLIC_KEYCLOAK_URL=http://localhost:8180
SECURESCAN_PUBLIC_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
KONG_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
KEYCLOAK_PUBLIC_HOSTNAME=http://localhost:8180
KEYCLOAK_SSL_REQUIRED=none
KEYCLOAK_FRONTEND_ROOT_URL=http://localhost:8080
KEYCLOAK_FRONTEND_BASE_URL=http://localhost:8080
KEYCLOAK_FRONTEND_CLIENT_ID=securescan-frontend
KEYCLOAK_FRONTEND_REDIRECT_URIS=http://localhost:8080/*
KEYCLOAK_FRONTEND_WEB_ORIGINS=http://localhost:8080
KEYCLOAK_FRONTEND_POST_LOGOUT_REDIRECT_URIS=http://localhost:8080/*
KEYCLOAK_DISABLE_DEMO_USERS=false

UPLOAD_DIR=/data/uploads
AVATAR_DIR=/data/avatars
MAX_UPLOAD_SIZE_MB=250
MAX_AVATAR_SIZE_MB=5
MONITORING_HTTP_TIMEOUT_SECONDS=2
KONG_STATUS_URL=http://kong:8100/status/ready
PROMETHEUS_HEALTH_URL=http://prometheus:9090/-/healthy
GRAFANA_HEALTH_URL=http://grafana:3000/api/health
POSTGRES_EXPORTER_METRICS_URL=http://postgres-exporter:9187/metrics
API_HEARTBEAT_ENABLED=true
API_HEARTBEAT_INTERVAL_SECONDS=5
API_HEARTBEAT_TIMEOUT_SECONDS=15
CONFIGURED_API_REPLICAS=2
AUTH_ENABLED=true
KEYCLOAK_ADMIN_USERNAME=keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KEYCLOAK_ISSUER=http://localhost:8180/realms/securescan
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=securescan
EMAIL_VERIFICATION_ENABLED=false
KEYCLOAK_EMAIL_ACTIONS_CLIENT_ID=securescan-frontend
KEYCLOAK_EMAIL_ACTIONS_REDIRECT_URL=http://localhost:8080/profile
# SMTP transazionale Keycloak: per Gmail usa smtp.gmail.com con App Password dedicata
KEYCLOAK_SMTP_HOST=
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=SecureScan Cloud
KEYCLOAK_SMTP_FROM=
KEYCLOAK_SMTP_AUTH=false
KEYCLOAK_SMTP_USER=
# Usa una Google App Password o una password applicativa equivalente, non la password normale dell'account.
KEYCLOAK_SMTP_PASSWORD=
KEYCLOAK_SMTP_SSL=false
KEYCLOAK_SMTP_STARTTLS=true
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/securescan/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=securescan-api
KEYCLOAK_ADMIN_CLIENT_ID=securescan-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-securescan-admin-api
KEYCLOAK_PASSWORD_VERIFICATION_CLIENT_ID=securescan-password-verification
KEYCLOAK_PASSWORD_VERIFICATION_CLIENT_SECRET=change-me-securescan-password-verification
KEYCLOAK_ADMIN_REQUEST_TIMEOUT_SECONDS=5
SECURESCAN_GATEWAY_URL=http://localhost:8000
SECURESCAN_KEYCLOAK_URL=http://localhost:8180
SECURESCAN_KEYCLOAK_REALM=securescan
SECURESCAN_RBAC_CLIENT_ID=securescan-rbac-demo
VITE_ANALYSIS_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=securescan
VITE_KEYCLOAK_CLIENT_ID=securescan-frontend
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TIMEOUT_SECONDS=15
WORKER_MIN_PROCESSING_SECONDS=0
WORKER_PROCESSING_TIMEOUT_SECONDS=120
WORKER_MAX_ATTEMPTS=3
WORKER_ID=
WORKER_HEALTH_PORT=8081
CLAMD_HOST=clamav
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=120
YARA_RULES_DIR=/srv/analysis-worker/rules
YARA_MATCH_TIMEOUT_SECONDS=30
KONG_RATE_LIMIT_GET_PER_MINUTE=600
KONG_RATE_LIMIT_ME_GET_PER_MINUTE=240
KONG_RATE_LIMIT_ME_WRITE_PER_MINUTE=60
KONG_RATE_LIMIT_POST_PER_MINUTE=30
KONG_RATE_LIMIT_DELETE_PER_MINUTE=10
KONG_MAX_REQUEST_SIZE_MB=256
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
